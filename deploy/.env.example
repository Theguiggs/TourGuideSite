DOMAIN=murmure-visit.com
API_DOMAIN=api.murmure-visit.com
MICROSERVICE_API_KEY=replace-with-openssl-rand-hex-32
# Clé OpenRouteService, CÔTÉ SERVEUR (relais /api/routing). Sans elle, les
# itinéraires piétons du Studio retombent en ligne droite.
ORS_API_KEY=
# Hôte(s) exact(s) du bucket S3 d'où le microservice accepte un audio pour la
# détection de silence. Le compose fournit le bucket du projet par défaut ;
# ne renseigner qu'en cas de changement de pile.
# ALLOWED_AUDIO_HOSTS=<bucket>.s3.us-east-1.amazonaws.com

# Même fenêtre ISO que le backend Amplify.
NEXT_PUBLIC_LAUNCH_FREE_ACCESS_START_AT=
NEXT_PUBLIC_LAUNCH_FREE_ACCESS_END_AT=
