# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Amplify backend outputs.
# NOTE : amplify_outputs.json est VOLONTAIREMENT SUIVI par git (le VPS de prod le
# récupère via `git clone` + `COPY . .` dans Dockerfile.web). Il ne contient aucun
# secret — configuration client publique, déjà embarquée dans l'APK.
# Le recopier depuis TourGuideApp/ après chaque redéploiement du backend, et committer.
# Ne pas le ré-ignorer ici : la ligne n'aurait aucun effet sur un fichier déjà suivi,
# elle ne ferait que laisser croire qu'il n'est pas versionné.

# Playwright
e2e/.auth/
playwright-report/
test-results/
.env.e2e
.venv/
microservice/.venv/

# Python bytecode (microservice)
__pycache__/
*.pyc

# Local dev artifacts
dev.log
.claude/
