# Next.js 16 standalone runtime — multi-stage
# Build: docker build -f Dockerfile.web -t murmure-web .
# Run  : docker run -p 3000:3000 --env-file .env.production murmure-web

# --- 1) deps stage: install dependencies
FROM node:20-alpine AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Copy manifests + local workspaces referenced via file:
COPY package.json package-lock.json* ./
COPY packages ./packages
RUN npm ci --no-audit --no-fund

# --- 2) build stage: produce .next/standalone
FROM node:20-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ENV SKIP_NEXT_TYPECHECK=true
# NEXT_PUBLIC_* vars are inlined at build time — must be passed as ARG
ARG NEXT_PUBLIC_AMPLITUDE_API_KEY
ARG NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
ENV NEXT_PUBLIC_AMPLITUDE_API_KEY=$NEXT_PUBLIC_AMPLITUDE_API_KEY
ENV NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=$NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages ./packages
COPY . .
RUN if [ ! -f ../TourGuideApp/amplify/data/resource.ts ]; then \
      mkdir -p ../TourGuideApp/amplify/data && \
      cp src/types/amplify-schema-fallback.ts ../TourGuideApp/amplify/data/resource.ts; \
    fi
# Empreinte de build. Next.js inline les NEXT_PUBLIC_* depuis .env.production au
# moment du build : on les y écrit juste avant. L'horodatage suffit à voir qu'un
# redéploiement a atterri ; le SHA, lui, doit être fourni par l'appelant, faute
# de quoi il vaut « dev » (le contexte Docker exclut .git, cf. .dockerignore).
ARG BUILD_SHA=dev
# UNE SEULE LIGNE PHYSIQUE, ET C'EST LA RAISON D'ÊTRE DE CE COMMENTAIRE.
# La rédaction d'origine étalait ce `printf` sur quatre lignes, en comptant sur
# les apostrophes pour les tenir ensemble. Le parseur de Docker ne lit pas le
# shell : sans `\` final, il traite chaque ligne physique comme une INSTRUCTION,
# et rendait « unknown instruction: NEXT_PUBLIC_BUILD_SHA=%s ».
#
# Conséquence, mesurée : ce fichier n'a plus construit du 2026-08-24 08:22 au
# 2026-08-30 — 23 commits bloqués, et le portail de production figé six jours.
# L'ironie mérite d'être écrite : c'est l'empreinte censée RÉVÉLER quel code
# tourne qui a empêché tout code de partir, et masqué son propre échec.
RUN printf 'NEXT_PUBLIC_BUILD_SHA=%s\nNEXT_PUBLIC_BUILD_TIME=%s\n' "$BUILD_SHA" "$(date -u +%Y-%m-%dT%H:%MZ)" >> .env.production

RUN npm run build

# --- 3) runner stage: minimal image
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs

# Standalone output bundles everything needed
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
